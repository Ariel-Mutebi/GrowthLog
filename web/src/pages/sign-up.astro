---
import { getImage } from "astro:assets";
import { Toaster } from "svelte-sonner";
import { Shell } from "../layouts/Shell.astro";
import { Banner } from "../components/Banner.astro";
import { Background } from "../components/Background.astro";
import { SignUp } from "../components/sign-up/SignUp.svelte";
import welcomeDark from "../assets/welcomeDark.jpg";
import welcomeLight from "../assets/welcomeLight.jpg";

const background = {
  dark: await getImage({ src: welcomeDark, format: "webp" }),
  light: await getImage({ src: welcomeLight, format: "webp" }),
};
---

<Shell title="GrowthLog | Sign-up">
  <Background
    light={background.light.src}
    dark={background.dark.src}
  />
  <Banner
    header="Join the community"
    headerColorDark="#E5D0D9"
    headerColorLight="#E7E9DD"
  />
  <SignUp client:load />
  <Toaster client:only="svelte" />
</Shell>
