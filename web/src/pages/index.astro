---
import { getImage } from "astro:assets";
import Shell from "../layouts/Shell.astro";
import SignUp from "../components/SignUp.svelte";
import welcomeDark from "../assets/welcomeDark.jpg";
import welcomeLight from "../assets/welcomeLight.jpg";

const backgroundDark = await getImage({ src: welcomeDark, format: "webp" });
const backgroundLight = await getImage({ src: welcomeLight, format: "webp" });
---

<Shell
  title="GrowthLog | Sign-up"
  header="Join the community"
  headerColorDark="#E5D0D9"
  headerColorLight="#E7E9DD"
  backgroundDark={backgroundDark.src}
  backgroundLight={backgroundLight.src}
>
  <SignUp client:load />
</Shell>
