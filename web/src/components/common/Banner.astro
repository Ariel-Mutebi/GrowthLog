---
import Theme from "./Theme.svelte";

interface Props {
  header: string;
  headerColorLight: string;
  headerColorDark: string;
}

const { header, headerColorLight, headerColorDark } = Astro.props;
---

<header class="flex p-3 md:pr-12 pb-12 gap-3 items-center">
  <img src="/logo-64.svg" class="w-16 h-16" alt="logo" />

  <h1 class="text-4xl font-bold">
    {header}
  </h1>

  <div class="ml-auto">
    <Theme client:load />
  </div>
</header>

<style define:vars={{ headerColorLight, headerColorDark }}>
  h1 {
    color: var(--headerColorLight);
  }

  :global(html.dark) h1 {
    color: var(--headerColorDark);
  }
</style>
