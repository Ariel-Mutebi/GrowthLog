---
import HeadLayout from "./HeadLayout.astro";
import Background from "../components/Background.astro";

interface Props {
  title: string;
  CTA: string;
  bgLight: string;
  bgDark: string;
}

const { title, CTA, bgLight, bgDark } = Astro.props;
---

<HeadLayout {title}>
  <div class="w-dvw min-h-dvh bg-orange-50 dark:bg-red-950 grid grid-cols-5">
    <div class="col-span-2 relative isolate">
      <Background light={bgLight} dark={bgDark} />
    </div>

    <div class="col-span-3">
      <slot />
    </div>
  </div>
</HeadLayout>
