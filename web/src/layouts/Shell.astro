---
import "../styles/global.css";
import { Font } from "astro:assets";
import Theme from "../components/Theme.svelte";

interface Props {
  title: string;
  header: string;
  headerColorLight: string;
  headerColorDark: string;
  backgroundLight: string;
  backgroundDark: string;
}

const {
  title,
  header,
  headerColorLight,
  headerColorDark,
  backgroundLight,
  backgroundDark,
} = Astro.props;
---

<html lang="en">
  <head>
    <script is:inline>
      (function () {
        const sitePreference = localStorage.getItem('theme');

        if (sitePreference) {
          document.documentElement.classList.toggle('dark', sitePreference == 'dark');
        } else {
          const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)');
          document.documentElement.classList.toggle('dark', systemPrefersDark.matches);
        }
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/logo-32.png" type="image/png" />
    <title>{title}</title>

    <Font cssVariable="--fraunces" />
    <Font cssVariable="--dm-mono" />
  </head>
  <body class="font-serif h-screen bg-center bg-cover">
    <header class="flex p-3 gap-3 items-center pb-12">
      <img src="/logo-64.svg" class="w-16 h-16" alt="logo" />
      <h1 class="site-header text-4xl font-bold">
        {header}
      </h1>

      <Theme client:load />
    </header>

    <slot />
  </body>
</html>

<style
  define:vars={{
    backgroundLightUrl: `url(${backgroundLight})`,
    backgroundDarkUrl: `url(${backgroundDark})`,
    headerColorLight,
    headerColorDark,
  }}
>
  body {
    background-image: var(--backgroundLightUrl);
  }

  :global(html.dark) body {
    background-image: var(--backgroundDarkUrl);
  }

  .site-header {
    color: var(--headerColorLight);
  }

  :global(html.dark) .site-header {
    color: var(--headerColorDark);
  }
</style>
