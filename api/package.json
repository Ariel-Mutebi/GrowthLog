{
  "name": "@growthlog/api",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "docker compose up -d",
    "stop": "docker compose down",
    "predev": "pnpm start",
    "dev": "tsx watch src/server.ts",
    "pretest": "pnpm start",
    "test": "tsx tests/setup.ts",
    "posttest": "pnpm stop",
    "gen:schema": "tsx openapi/generate.ts"
  },
  "exports": {
    ".": "./openapi/schema.d.ts"
  },
  "author": "Ariel Robert Mutebi",
  "license": "BUSL-1.1",
  "type": "module",
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/passport": "^3.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/session": "^11.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@growthlog/db": "workspace:*",
    "@prisma/client": "^7.9.1",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "connect-redis": "^10.0.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "jiti": "^2.7.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "redis": "^6.1.0",
    "slugify": "^1.6.9",
    "zxcvbn-ts": "^2.3.3"
  },
  "devDependencies": {
    "@fastify/swagger-ui": "^6.1.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@testcontainers/redis": "^12.0.4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.5",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
