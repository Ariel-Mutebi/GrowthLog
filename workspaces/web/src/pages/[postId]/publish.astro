---
import { createApiClient } from "../../server/clients.ts";
import HeadLayout from "../../layouts/HeadLayout.astro";
import Avatar from "../../components/Avatar.svelte";
import LinkLogo from "../../components/write/LinkLogo.astro";
import RibbonNav from "../../components/write/RibbonNav.astro";
import VerticalRibbon from "../../components/write/VerticalRibbon.astro";
import Publish from "../../components/publish/Publish.svelte";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/login", 302);
}

const postId = Astro.params.postId!;
const cookie = Astro.request.headers.get("cookie");

const { data: prepublish } = await createApiClient(cookie).GET("/api/me/drafts/{id}/publish", {
  params: {
    path: {
      id: postId,
    }
  }
});

if (!prepublish) {
  return Astro.rewrite("/404");
}
---

<HeadLayout title="Publish your story | GrowthLog">
  <div class="min-h-dvh bg-amber-100 dark:bg-olive-900">
    <LinkLogo backLink={`/${postId}/edit`} />
    <RibbonNav>
      <Avatar avatarKey={user.avatarKey} size="small" />
    </RibbonNav>
    <VerticalRibbon />
    <div class="pt-16 px-4 md:p-16 md:pb-0 flex items-start flex-wrap gap-y-6">
      <h1 class="font-serif text-8xl md:text-9xl text-stone-600 dark:text-olive-400 display-heading">
        Publish
      </h1>
      <Publish
        {postId}
        initial={prepublish}
        mockUrlBase={`https://growthlog.com/`}
        client:idle
      />
    </div>
  </div>
</HeadLayout>
