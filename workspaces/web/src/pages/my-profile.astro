---
import RegistrationLayout from "../layouts/RegistrationLayout.astro";
import catsCuddling from "../assets/cats-cuddling.jpg";
import dogThinking from "../assets/dog-thinking.jpg";
import Onboarding from "../components/onboarding/Onboarding.svelte";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect('/login', 302);
}
---

<RegistrationLayout
  title="Growthlog | Profile"
  CTA="Make GrowthLog your own"
  bgLight={catsCuddling}
  bgDark={dogThinking}
  blend={true}
>
  <Onboarding username={user.username} client:load />
</RegistrationLayout>
