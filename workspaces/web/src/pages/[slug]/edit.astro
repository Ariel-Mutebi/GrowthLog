---
import { createApiClient } from "../../server/clients.ts";
import HeadLayout from "../../layouts/HeadLayout.astro";
import Editor from "../../components/write/Editor.svelte";
import Avatar from "../../components/Avatar.astro";
import UndoRedo from "../../components/write/UndoRedo.svelte";
import Upload from "../../components/write/Upload.svelte";
import Publish from "../../components/write/PublishButton.svelte";
import LinkLogo from "../../components/write/LinkLogo.astro";
import RibbonNav from "../../components/write/RibbonNav.astro";
import VerticalRibbon from "../../components/write/VerticalRibbon.astro";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/login", 302);
}

const slug = Astro.params.slug!;

const { data: post } = await createApiClient(
  Astro.request.headers.get("cookie"),
).GET("/api/posts/{slug}", {
  params: {
    path: {
      slug,
    },
  },
});

if (!post) {
  return Astro.rewrite("/404");
}
---

<HeadLayout title={`Editing ${post.title} | GrowthLog`}>
  <div class="min-h-dvh bg-white dark:bg-black">
    <LinkLogo backLink="/my-drafts" />
    <RibbonNav>
      <div class="flex px-2 py-1 gap-4 bg-lime-200 dark:bg-lime-800">
        <Upload postId={post.id} client:load />
        <UndoRedo client:load />
      </div>
      <Publish {slug} client:load />
      <Avatar avatarKey={user.avatarKey} />
    </RibbonNav>
    <VerticalRibbon />
    <div class="p-8 md:p-16 md:pl-32 flex justify-center">
      <Editor {user} postId={post.id} initialTitle={post.title} client:load />
    </div>
  </div>
</HeadLayout>
