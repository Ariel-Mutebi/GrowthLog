---
import { createApiClient } from "../../server/clients.ts";
import HeadLayout from "../../layouts/HeadLayout.astro";
import Editor from "../../components/write/Editor.svelte";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/login", 302);
}

const apiClient = createApiClient(Astro.request.headers.get("cookie"));
const postId = Astro.params.postId!;

const { data: post } = await apiClient.GET("/api/posts/{id}", {
  params: {
    path: {
      id: postId,
    },
  },
});

if (!post) {
  return Astro.rewrite("/404");
}
---

<HeadLayout title={post.title}>
  <Editor {user} {postId} initialTitle={post.title} client:only="svelte" />
</HeadLayout>
