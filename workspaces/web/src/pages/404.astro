---
import { Image } from "astro:assets";
import NavBar from "../components/Navbar.astro";
import HeadLayout from "../layouts/HeadLayout.astro";
import aerialForest from "../assets/aerial-forest.jpg";

Astro.response.status = 404;
const { user } = Astro.locals;
---

<HeadLayout title="Not Found | GrowthLog">
  <div class="h-dvh w-dvw relative">
    <Image
      alt=""
      src={aerialForest}
      format="webp"
      sizes="100dvw"
      widths={[640, 1024, 1920]}
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="z-10 isolate">
      <NavBar avatarKey={user?.avatarKey} />
      <h1 class="font-serif text-[22dvw]/none text-lime-100">GrowthLog</h1>
    </div>
  </div>
</HeadLayout>
