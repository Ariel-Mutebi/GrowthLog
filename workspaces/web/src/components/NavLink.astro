---
import type Layers from "@lucide/astro/icons/layers";

interface Props {
  href: string;
  text: string;
  Icon: typeof Layers;
}

const { href, text, Icon } = Astro.props;
const isCurrent = Astro.url.pathname === href;
---

<a
  {href}
  aria-current={isCurrent ? "page" : undefined}
  class="p-3 min-w-50 flex gap-2 items-center bg-lime-50 dark:bg-lime-950 text-stone-800 hover:text-stone-900
    dark:text-stone-200 dark:hover:text-stone-100 rounded-xl inset-shadow-[1px_1px_4px] inset-shadow-stone-300
    dark:inset-shadow-stone-400/25 aria-[current=page]:bg-lime-100 aria-[current=page]:dark:bg-lime-900
    aria-[current=page]:font-semibold"
>
  <Icon aria-hidden="true" />
  {text}
</a>
