---
import Logo from '../Logo.astro';
import Theme from '../Theme.svelte';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<nav class="w-full flex justify-between items-center">
  <header class="flex items-center py-2 px-3 sm:p-0 gap-1 md:gap-2 lg:gap-3">
    <Logo />
    <h1 class="font-serif text-xl sm:text-2xl lg:text-3xl text-stone-600 dark:text-stone-200">{title}</h1>
  </header>

  <Theme client:load />
</nav>
