{
  "name": "@growthlog/images",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "predev": "pnpm -w run docker:up",
    "dev": "tsx watch src/server.ts",
    "gen:types": "tsx openapi/generate.ts"
  },
  "exports": {
    ".": {
      "types": "./openapi/schema.d.ts"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@fastify/autoload": "^6.5.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.9.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@growthlog/db": "workspace:*",
    "@growthlog/env": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "file-type": "^22.1.1",
    "image-size": "^2.0.4",
    "jsonwebtoken": "^9.0.3",
    "openapi-typescript": "^7.13.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
