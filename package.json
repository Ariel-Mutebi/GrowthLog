{
  "name": "growthlog",
  "private": true,
  "author": "Ariel Robert Mutebi",
  "license": "BUSL-1.1",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript-eslint": "^8.70.1"
  },
  "lint-staged": {
    "api/src/**/*.ts": [
      "eslint --fix"
    ],
    "web/src/**/*.ts": [
      "eslint --fix"
    ]
  }
}
