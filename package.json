{
  "name": "growthlog",
  "private": true,
  "author": "Ariel Robert Mutebi",
  "license": "BUSL-1.1",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "prepare": "husky",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "predev": "pnpm run docker:up",
    "dev": "pnpm --parallel --filter api --filter web --filter images --filter docs --filter jobs dev",
    "test": "pnpm --parallel --filter api --filter images test",
    "smoke": "TAG=local docker compose -p growthlog-smoke -f compose.prod.yaml -f compose.smoke.yaml"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript-eslint": "^8.70.1"
  },
  "lint-staged": {
    "workspaces/**/*.ts": [
      "eslint --fix"
    ]
  }
}
